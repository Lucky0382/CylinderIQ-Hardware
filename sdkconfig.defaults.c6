# CylinderIQ Hub V2 — sdkconfig.defaults.c6 (ESP32-C6 specific)

# Flash (C6-Zero has 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4MB.csv"

# WiFi — SoftAP required
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE_DYNAMIC=y

# DHCP server (for AP clients)
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4

# TCP/IP stack
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y

# HTTP server
CONFIG_HTTPD_MAX_OPEN_SOCKETS=7
CONFIG_HTTPD_QUEUE_SIZE=10

# IEEE 802.11 country
CONFIG_ESP_PHY_ENABLE_WIFI_REGION_INFO=n

# USB console on C6 (UART0 is USB-Serial)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Zigbee coordinator ────────────────────────────────────────
# Enable IEEE 802.15.4 radio (shared RF with Wi-Fi on C6)
CONFIG_IEEE802154_ENABLED=y

# Zigbee stack — coordinator role
CONFIG_ZB_ENABLED=y
CONFIG_ZB_SDK_1xx=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_COORDINATOR_ROLE=y
CONFIG_ZB_ZCL_SUPPORT_CLUSTER_ON_OFF=y

# Wi-Fi + IEEE 802.15.4 radio coexistence
# Time-division multiplexing of the shared 2.4GHz RF front-end.
# Throughput reduced slightly but perfectly adequate for sensor hub.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_COEX_EXTERNAL_COEXIST_ENABLE=n

# Zigbee task stack — increase slightly for coordinator role
CONFIG_ZB_STACK_TASK_STACK_SIZE=4096
CONFIG_ZB_MAIN_TASK_STACK_SIZE=4096

