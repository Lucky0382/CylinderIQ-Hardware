# CylinderIQ Hub V2 — sdkconfig.defaults.c6 (ESP32-C6 Dedicated Zigbee Coordinator)

# Flash (C6-Zero has 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_4MB.csv"

# Disable WiFi on C6 (Wi-Fi SoftAP & HTTP Server run entirely on ESP32-S3)
CONFIG_ESP_WIFI_ENABLED=n

# Console on C6 (UART0 is connected to on-board CH343 USB chip)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ── Zigbee coordinator ────────────────────────────────────────
# Enable IEEE 802.15.4 radio (100% dedicated RF spectrum, no Wi-Fi coexistence)
CONFIG_IEEE802154_ENABLED=y

# Zigbee stack — coordinator role
# NOTE: CONFIG_ZB_SDK_1xx enables v1-compat API shims on the v2.0.4 library.
# Full v2 migration is planned but not safe under time pressure.
# The compat macros correctly map to native v2 functions at compile time.
CONFIG_ZB_ENABLED=y
CONFIG_ZB_SDK_1xx=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_COORDINATOR_ROLE=y
CONFIG_ZB_ZCL_SUPPORT_CLUSTER_ON_OFF=y

# Zigbee task stack — increased for v2.x native coordinator role & NVS serialization
CONFIG_ZB_STACK_TASK_STACK_SIZE=12288
CONFIG_ZB_MAIN_TASK_STACK_SIZE=12288

# ── Brownout detector ──────────────────────────────────────────
# Default level (SEL_7, ~2.79V) trips on brief voltage sag caused by
# 802.15.4 TX current spikes (esp. during permit-join broadcasts) on
# marginal USB power, causing a reset loop that repeatedly re-enumerates
# the onboard USB-UART chip. Lower sensitivity to stop false resets.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_3=y
