# CylinderIQ Hub V2 — sdkconfig.defaults.s3 (ESP32-S3 specific)

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# OPI PSRAM (8MB, octal)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# NVS
CONFIG_NVS_ASSERT_ERROR_CHECK=n

# OneWire GPIO — allow GPIO interrupts from task context
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# DS18B20 needs relatively long stack for sensor task
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# WiFi SoftAP on S3
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE_DYNAMIC=y

# DHCP server
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4

# TCP/IP stack
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y

# HTTP server
CONFIG_HTTPD_MAX_OPEN_SOCKETS=7
CONFIG_HTTPD_QUEUE_SIZE=10

# Wi-Fi + BLE Coexistence on S3
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# NimBLE BLE stack (no Bluedroid — lighter RAM footprint)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
# No bonding required — pairing capability stays at default (present but unused)

# USB serial/JTAG for debug (UART0 used by USB bridge on S3-DevKitC)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
